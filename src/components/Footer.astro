---
import { t as T, urls, AIRBNB_MESSAGE, PHONE, PHONE_SHOWN, WHATSAPP, type Lang, type Page } from '../i18n';
import { ARROW } from '../icons';
import LangSwitch from './LangSwitch.astro';
interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const t = T(lang);
const home = page === 'home' ? '' : urls.home[lang]; // anchors stay on the home page, other pages link back to it
---
<footer class="foot"><div class="wrap">
  <div class="top">
    <div class="rv">
      <h2>{t(`Prêts pour le Gard ?`,`Ready for the Gard?`)}</h2>
      <p class="strap">{t(`on vous attend à Lédenon`,`see you in Lédenon`)}</p>
      <a class="pill primary" style="margin-top:1.6rem" href={urls.book[lang]}><span class="dot"><Fragment set:html={ARROW} /></span><span>{t(`Voir les dates`,`Check dates`)}</span></a>
    </div>
    <div class="cols rv" style="--i:1">
      <div><h4>Contact</h4><ul>
        <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span>2 rue du Réservoir, 30210 Lédenon</span></li>
        <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3.5l1.5 4.5-2 1.5a11 11 0 0 0 6 6l1.5-2 4.5 1.5V19a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><a href={`tel:${PHONE}`}>{PHONE_SHOWN}</a></li>
        <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 16 0 8 8 0 0 0-16 0zM4 12h16M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"/></svg><a href={WHATSAPP} rel="noopener">{t(`WhatsApp ou SMS`,`WhatsApp or text`)}</a></li>
        <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg><a href={AIRBNB_MESSAGE} rel="noopener">{t(`Message sur Airbnb`,`Message us on Airbnb`)}</a></li>
      </ul></div>
      <div><h4>{t(`Le site`,`Quick links`)}</h4><ul>
        <li><a href={urls.house[lang]}>{t(`La maison`,`The house`)}</a></li>
        <li><a href={urls.area[lang]}>{t(`Les alentours`,`The area`)}</a></li>
        <li><a href={urls.practical[lang]}>{t(`Infos pratiques`,`Practical information`)}</a></li>
        <li><a href={home + '#reviews'}>{t(`Les avis`,`Reviews`)}</a></li>
        <li><a href={home + '#hosts'}>{t(`Votre hôte`,`Your host`)}</a></li>
        <li><a href={urls.book[lang]}>{t(`Réserver`,`Book`)}</a></li>
      </ul></div>
      <div><h4>{t(`Langue`,`Language`)}</h4><ul>
        <li><LangSwitch lang={lang} page={page} /></li>
      </ul></div>
    </div>
  </div>
  <div class="legal">
    <span>{t(`Meublé de tourisme · numéro d'enregistrement : à venir`,`Meublé de tourisme · registration number: to come`)}</span>
    <span>© 2026 Les Calades · <a href={urls.owner[lang]} rel="nofollow">{t(`Espace propriétaire`,`Owner area`)}</a></span>
  </div>
</div></footer>
