---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Calendar from './Calendar.astro';
import Footer from './Footer.astro';
import '../styles/book.css';
import { t as T, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T(lang);
const page = 'book';
---
<Base lang={lang} page={page} title={t('Réserver · Les Calades', 'Book · Les Calades')} description={t('Les dates libres aux Calades, à Lédenon. Choisissez les vôtres, puis réservez-les sur Airbnb.', 'The free dates at Les Calades, in Lédenon. Pick yours, then book them on Airbnb.')}>
  <header class="masthead" id="top">
    <Nav lang={lang} page={page} />
  </header>
<section class="bk-head"><div class="wrap">
  <div class="row">
    <div class="rv">
      <h2>{t(`Réserver`,`Book your dates`)}</h2>
      <p class="strap">{t(`une semaine au moins, et moitié prix pour un mois`,`a week at least, and half price for a month`)}</p>
      <p class="lede">{t(`Choisissez vos dates ici, puis réservez-les sur Airbnb : le prix exact, le paiement et la caution y sont gérés. Le calendrier est le même des deux côtés.`,`Pick your dates here, then book them on Airbnb: the exact price, payment and deposit are handled there. The calendar is the same on both sides.`)}</p>
    </div>
  </div>
</div></section>

  <Calendar lang={lang} page={page} />
<section class="dark how" id="how">
  <img src="/img/7.jpg" alt="" aria-hidden="true">
  <div class="wrap">
    <div class="rv">
      <h2>{t(`Comment ça marche`,`How it works`)}</h2>
      <p class="strap">{t(`trois étapes, et Airbnb pour le paiement`,`three steps, with Airbnb for the payment`)}</p>
    </div>
    <div class="steps">
      <div class="st rv" style="--i:1"><b>1</b><h3>{t(`Choisissez vos dates`,`Pick your dates`)}</h3><p>{t(`Le calendrier ne montre que les dates libres, et vous dit le séjour minimum pour votre date d'arrivée : une semaine, parfois plus en hiver.`,`The calendar only shows free dates, and tells you the minimum stay for your check-in date: a week, sometimes more in winter.`)}</p></div>
      <div class="st rv" style="--i:2"><b>2</b><h3>{t(`Réservez sur Airbnb`,`Book on Airbnb`)}</h3><p>{t(`Le bouton ouvre notre annonce avec vos dates et vos voyageurs déjà renseignés. Vous y voyez le prix exact et payez là-bas, avec la protection et les conditions d'annulation d'Airbnb.`,`The button opens our listing with your dates and party size already filled in. You see the exact price and pay there, with Airbnb's cover and cancellation terms.`)}</p></div>
      <div class="st rv" style="--i:3"><b>3</b><h3>{t(`Laure vous accueille`,`Laure welcomes you`)}</h3><p>{t(`À partir de 17 h le jour de l'arrivée, avec les clés et le tour de la maison. Une question avant ? WhatsApp ou SMS.`,`From 5 pm on the day you arrive, with the keys and a tour of the house. A question before then? WhatsApp or text.`)}</p></div>
    </div>
  </div>
</section>

  <Footer lang={lang} page={page} />
</Base>
