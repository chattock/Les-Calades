---
import galleries from '../data/galleries.json';
---
<div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Photos" hidden>
  <button class="lb-x" type="button" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
  <figure class="lb-fig"><img class="lb-img" src="" alt=""><figcaption><span class="lb-cap"></span><span class="lb-n"></span></figcaption></figure>
  <button class="lb-btn lb-next" type="button" aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
</div>
<script is:inline define:vars={{ G: galleries }}>
(function(){
  var lb=document.getElementById('lightbox'); if(!lb) return;
  var img=lb.querySelector('.lb-img'), cap=lb.querySelector('.lb-cap'), num=lb.querySelector('.lb-n'), prev=lb.querySelector('.lb-prev'), next=lb.querySelector('.lb-next'), x=lb.querySelector('.lb-x');
  var list=[], i=0, last=null;
  function lang(){ return document.documentElement.getAttribute('data-lang')==='fr'?1:2; }
  function show(k){ i=(k+list.length)%list.length; var it=list[i]; img.src='/img/'+it[0]+'.jpg'; img.alt=it[lang()]; cap.textContent=it[lang()]; cap.hidden=!it[lang()]; num.textContent=(i+1)+' / '+list.length;
    [i+1,i-1].forEach(function(j){ var n=list[(j+list.length)%list.length]; if(n){ var p=new Image(); p.src='/img/'+n[0]+'.jpg'; } }); }
  function open(key,start){ list=G[key]||[]; if(!list.length) return; last=document.activeElement; lb.hidden=false; document.body.style.overflow='hidden'; requestAnimationFrame(function(){ lb.classList.add('on'); }); show(start||0); x.focus(); }
  function close(){ lb.classList.remove('on'); document.body.style.overflow=''; setTimeout(function(){ lb.hidden=true; },250); if(last&&last.focus) last.focus(); }
  document.querySelectorAll('[data-gallery]').forEach(function(el){
    if(el.classList.contains('marquee')) return;
    el.addEventListener('click',function(e){ e.preventDefault(); open(el.getAttribute('data-gallery'),0); });
  });
  prev.addEventListener('click',function(){ show(i-1); }); next.addEventListener('click',function(){ show(i+1); }); x.addEventListener('click',close);
  lb.addEventListener('click',function(e){ if(e.target===lb) close(); });
  document.addEventListener('keydown',function(e){ if(lb.hidden) return; if(e.key==='Escape') close(); else if(e.key==='ArrowLeft') show(i-1); else if(e.key==='ArrowRight') show(i+1); });
  var tx=null; lb.addEventListener('touchstart',function(e){ tx=e.touches[0].clientX; },{passive:true}); lb.addEventListener('touchend',function(e){ if(tx===null) return; var d=e.changedTouches[0].clientX-tx; tx=null; if(Math.abs(d)>40) show(d<0?i+1:i-1); });
  window.__openGallery=open;

  /* the room-by-room row: drifts on its own, drags, and opens the tour */
  var mq=document.querySelector('.marquee'); if(!mq) return;
  var track=mq.querySelector('.track'), figs=Array.prototype.slice.call(track.querySelectorAll('figure')), half=figs.length/2;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches, hover=false, drag=false, moved=0, sx=0, sl=0, vel=0.45, pos=0, hit=null;
  function halfW(){ return track.scrollWidth/2; }
  function wrap(){ var h=halfW(); if(mq.scrollLeft>=h) mq.scrollLeft-=h; else if(mq.scrollLeft<0) mq.scrollLeft+=h; }
  function tick(){ if(!reduce&&!hover&&!drag&&lb.hidden){ pos+=vel; if(Math.abs(pos-mq.scrollLeft)>=1){ mq.scrollLeft=Math.round(pos); wrap(); pos=mq.scrollLeft; } } else { pos=mq.scrollLeft; } requestAnimationFrame(tick); }
  requestAnimationFrame(tick);
  mq.addEventListener('mouseenter',function(){ hover=true; }); mq.addEventListener('mouseleave',function(){ hover=false; });
  mq.addEventListener('pointerdown',function(e){ if(e.pointerType==='mouse'&&e.button!==0) return; drag=true; moved=0; sx=e.clientX; sl=mq.scrollLeft; hit=e.target.closest?e.target.closest('figure'):null; mq.classList.add('dragging'); mq.setPointerCapture(e.pointerId); });
  mq.addEventListener('pointermove',function(e){ if(!drag) return; var d=e.clientX-sx; moved=Math.max(moved,Math.abs(d)); mq.scrollLeft=sl-d; wrap(); });
  function end(e){ var tap=drag&&moved<=6&&hit&&e.type==='pointerup'; drag=false; mq.classList.remove('dragging'); pos=mq.scrollLeft; if(tap){ open('tour', parseInt(hit.getAttribute('data-i')||'0',10)); } hit=null; }
  mq.addEventListener('pointerup',end); mq.addEventListener('pointercancel',end);
  mq.addEventListener('scroll',function(){ if(!drag) wrap(); },{passive:true});
})();
</script>
