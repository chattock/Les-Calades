---
import { t as T, urls, type Lang, type Page } from '../i18n';
import { ARROW, PLUS, PLUS_ICON, STAR } from '../icons';
import LangSwitch from './LangSwitch.astro';
interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const t = T(lang);
const home = page === 'home' ? '' : urls.home[lang]; // anchors stay on the home page, other pages link back to it
---
<section class="more"><div class="wrap grid">
  <div class="rv">
    <h2>{t(`Charme rustique, confort moderne`,`Rustic charm, modern comforts`)}</h2>
    <p class="strap">{t(`une vieille maison dans un vieux village`,`an old house in an old village`)}</p>
    <ul class="feat">
      <li><h3>{t(`Quatre chambres, trois salles de bain`,`Four bedrooms, three bathrooms`)}</h3><p>{t(`Sur plusieurs niveaux, toutes climatisées, avec un lit à baldaquin sous les poutres.`,`Over several floors, all air-conditioned, with a four-poster under the beams.`)}</p></li>
      <li><h3>{t(`À l'ombre d'un château du XIIe siècle`,`In the shadow of a 12th-century château`)}</h3><p>{t(`Un village agricole sur sa colline, des vignes et des oliviers tout autour, et les ruines du château au-dessus des toits.`,`An agricultural village on its hill, vines and olive trees all around, and the château ruin above the roofs.`)}</p></li>
      <li><h3>{t(`Wifi rapide, climatisation, parking fermé`,`Fast wifi, air conditioning, gated parking`)}</h3><p>{t(`Les conforts modernes dans des murs anciens ; trois voitures à l'abri, une dehors.`,`Modern comforts inside old walls; three cars behind the gate, one outside.`)}</p></li>
      <li><h3>{t(`Nîmes, Uzès, le Pont du Gard, Avignon`,`Nîmes, Uzès, the Pont du Gard, Avignon`)}</h3><p>{t(`Tous à moins de quarante minutes ; les marchés, la Camargue et la mer un peu plus loin.`,`All within forty minutes; the markets, the Camargue and the sea a little further.`)}</p></li>
    </ul>
  </div>
  <figure class="rv" style="--i:2">
    <div class="photo"><img src="/img/33.jpg" alt="The stone house seen from the garden, with oleander and the terrace"></div>
  </figure>
</div></section>

<div class="band" aria-hidden="true"></div>
